# ==============================================================================
# dmanager — environment configuration for Docker Compose
# ==============================================================================
# Copy this file to .env and adjust as needed. docker compose reads .env from
# the project directory automatically (values can also come from the shell
# environment). Every variable is optional: compose falls back to the same safe
# defaults shown below, so a missing .env still yields a working local stack.

# Host port for the Web UI and ConnectRPC API. Maps to the fixed internal
# container port 9283 (compose-only; the app always listens on 9283 inside).
DMANAGER_PORT=9283

# Minutes between automatic image update checks (default: 60)
DMANAGER_SCHEDULER_INTERVAL_MINUTES=60

# WebAuthn / Passkey login. The localhost defaults below serve local testing on
# http://localhost:9283. For real deployments set the domain the UI is served
# under — a stable hostname, NOT an IP (browsers refuse WebAuthn on IP origins):
#   DMANAGER_WEBAUTHN_RP_ID=dmanager.example.com
#   DMANAGER_WEBAUTHN_ORIGINS=https://dmanager.example.com
DMANAGER_WEBAUTHN_RP_ID=localhost
DMANAGER_WEBAUTHN_ORIGINS=http://localhost:9283

# Registry credentials for private-image update checks (0-indexed; add 1_, 2_…
# blocks as needed). Set values here AND uncomment the matching lines in
# docker-compose.yml so they are passed into the container.
#DMANAGER_REGISTRIES_0_HOST=ghcr.io
#DMANAGER_REGISTRIES_0_USERNAME=myuser
#DMANAGER_REGISTRIES_0_PASSWORD=mypassword

# Embedded Tailscale node (docs/tailscale.md): off unless the auth key is set.
# Use a tagged, reusable key. Node state persists under /var/lib/dmanager/
# tailscale (same volume as the database), so the key is only needed on first
# start. No ports need to be published.
TAILSCALE_AUTHKEY=
#TAILSCALE_HOSTNAME=dmanager
# Serve HTTPS on tailnet :443 with Tailscale-issued certs (default: false)
#TAILSCALE_HTTPS_ENABLED=false

# SMTP relay for system email (docs/design.md §13). Off by default and fully
# inert until enabled. When enabled, host, port and from_email are required
# (enforced at startup). tls_mode: none | starttls | tls. Credentials live in
# this file / the environment, never in the database.
#DMANAGER_SMTP_ENABLED=true
#DMANAGER_SMTP_HOST=smtp.example.com
#DMANAGER_SMTP_PORT=587
#DMANAGER_SMTP_USERNAME=
#DMANAGER_SMTP_PASSWORD=
#DMANAGER_SMTP_FROM_EMAIL=noreply@example.com
#DMANAGER_SMTP_FROM_NAME=dmanager
#DMANAGER_SMTP_TLS_MODE=starttls
#DMANAGER_SMTP_TIMEOUT_SECONDS=15

# ==============================================================================
# Optional overrides (safe defaults; uncomment to change)
# ==============================================================================

# JSON log output when set to production (APP_ENV is an alternative spelling)
#DMANAGER_ENV=production

# Trust X-Forwarded-For from a reverse proxy for client-IP extraction
#DMANAGER_SERVER_TRUSTED_PROXY=false

# Comma-separated list of allowed CORS origins
#DMANAGER_SERVER_ALLOWED_ORIGINS=

# Session timeouts (idle/absolute; remember-me variants separately)
#DMANAGER_AUTH_SESSION_IDLE_TIMEOUT=168h
#DMANAGER_AUTH_SESSION_ABSOLUTE_TIMEOUT=720h
#DMANAGER_AUTH_REMEMBER_ME_IDLE_TIMEOUT=720h
#DMANAGER_AUTH_REMEMBER_ME_ABSOLUTE_TIMEOUT=2160h

# Cookie Secure attribute mode: auto (HTTPS requests only) | always | never
#DMANAGER_AUTH_SECURE_COOKIES=auto

# Bcrypt cost for new or changed passwords, 4-31
#DMANAGER_AUTH_BCRYPT_COST=12
