{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "node": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["dist/**", "src/gen/**"],
  "rules": {
    "typescript/no-non-null-assertion": "off",
    "unicorn/consistent-function-scoping": "off"
  }
}
